# Copie este arquivo para .env e preencha os valores.
# Cada ambiente (seu PC, testes, produção) tem o SEU .env, com valores diferentes.

# development | production
NODE_ENV=development
PORT=3030

# Chave para assinar os tokens de login. Use uma diferente em cada ambiente.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Banco de dados
# - Sem DATABASE_URL: SQLite no arquivo DATABASE_PATH, com schema sincronizado automaticamente (desenvolvimento)
# - Com DATABASE_URL: PostgreSQL (produção/Supabase); o schema muda só por migrations (npm run migration:run)
DATABASE_PATH=./src/database/orion.sqlite
# DATABASE_URL=postgresql://usuario:senha@host:6543/postgres
# DATABASE_SCHEMA=orion

# Endereço do frontend (link do e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:3000

# Quem pode chamar a API pelo navegador (vários: separe por vírgula). Vazio = libera tudo.
CORS_ORIGIN=

# Conta Gmail que envia os e-mails de recuperação de senha (use uma "senha de app")
EMAIL=
SENHAEMAIL=
